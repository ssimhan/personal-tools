{
  "manifest_version": 3,
  "name": "CRM",
  "version": "0.3.7",
  "description": "Look up, edit, and log interactions to your personal CRM from a side panel that stays open as you browse.",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://crm.andymowat.com/*"
  ],
  "action": {
    "default_title": "CRM"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
