# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (vision + text)
ANTHROPIC_API_KEY=
VISION_MODEL=claude-haiku-4-5-20251001
TEXT_MODEL=claude-haiku-4-5-20251001

# OpenAI (embeddings only)
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Resend (broadcast email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Semantic search
# Hard similarity floor — results below this are hidden entirely.
# Starting value per PRD; tune during first week of real use.
SEMANTIC_SIMILARITY_FLOOR=0.75

# Auth — single user only.
# Comma-separated emails allowed to sign in. Anything else is rejected.
ALLOWED_USER_EMAILS=

# Optional. When set, ALL allowed sign-in emails access the SAME CRM data
# owned by this canonical user. Leave empty for per-user data isolation.
# Bootstrap rule: the canonical email MUST sign in first to create its account.
CANONICAL_OWNER_EMAIL=

# Optional. When set, sign-in requires this exact password. The same value is
# used as the underlying Supabase Auth password, so there's no separate
# "create your password" step. Pick something long and random.
AUTH_PASSWORD=

# Optional. When set, the Chrome extension can authenticate by sending
# Authorization: Bearer <this value>. Generate with `openssl rand -hex 32`.
# Requires CANONICAL_OWNER_EMAIL to be set (extension operates on that
# user's data).
EXTENSION_API_KEY=

# Absolute base URL of the deployed app (e.g. https://crm.andymowat.com).
# Used to build the contact-update link in outgoing broadcast emails.
APP_BASE_URL=

# Shared secret for the inbound-email (BCC-to-log) webhook. Generate with
# `openssl rand -hex 32`. Postmark posts to /api/inbound/postmark?token=<this>.
INBOUND_EMAIL_SECRET=
